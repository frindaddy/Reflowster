Button {
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

HorizontalGroup {
    height: 1fr;
}

ReflowControl {
    align: center middle;
    margin: 2;
    padding: 2;
    width: 25;
    max-width: 25;
    height: 100%;
}

ReflowCurvePlot {
    align: center middle;
    padding: 1;
    width: 1fr;
    height: 100%;
}

#profile-list {
    margin: 5 20 5 20;
    padding: 0 1 1 1;
}

#profile-selection {
    height: auto;
    align-horizontal: center;
    width: 100%;
    margin-top: 1;
}
